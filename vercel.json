{
  "framework": null,
  "buildCommand": "cp agent/port-station.mjs web/port-station.mjs",
  "outputDirectory": "web",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/port-station.mjs", "headers": [
      { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
      { "key": "Content-Disposition", "value": "attachment; filename=port-station.mjs" }
    ] }
  ]
}
